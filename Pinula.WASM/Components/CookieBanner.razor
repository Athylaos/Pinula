@using System.Globalization
@using Microsoft.Extensions.Localization
@using Pinula.Shared.Interface
@inject IJSRuntime JSRuntime
@inject NavigationManager NavManager
@inject IStringLocalizer<App> Localizer
@inject ILocalStorage LocalStorage

@if (showBanner)
{
    <div class="cookie-banner-overlay">
        <div class="culture-toggle-container position-absolute login-language-container">
            <button class="btn-culture-toggle @(CurrentCulture == "en" ? "active" : "")" @onclick='() => ChangeCulture("en")'>
                EN
            </button>
            <button class="btn-culture-toggle @(CurrentCulture == "cs" ? "active" : "")" @onclick='() => ChangeCulture("cs")'>
                CZ
            </button>
        </div>
        <div class="cookie-content">
            <h4>@Localizer["Cookies1"]</h4>
            <p>
                @Localizer["Cookies2"]
                <a href="/terms" class="cookie-link">@Localizer["Cookies3"]</a>.
            </p>
        </div>
        <div class="cookie-actions">
            <button class="btn-cookie-accept" @onclick='() => SaveConsent("essential")'>OK</button>
        </div>
    </div>
}

@code {
    private bool showBanner = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var consent = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "pinula_cookie_consent");
            if (string.IsNullOrEmpty(consent))
            {
                showBanner = true;
                StateHasChanged();
            }
        }
    }

    private async Task SaveConsent(string consentType)
    {
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "pinula_cookie_consent", consentType);
        showBanner = false;
        StateHasChanged();
    }
    private string CurrentCulture => CultureInfo.CurrentCulture.Name;
    private async Task ChangeCulture(string cultureCode)
    {
        if (CurrentCulture == cultureCode) return;
        await LocalStorage.SetStringAsync("culture", cultureCode);

        NavManager.NavigateTo(NavManager.Uri, forceLoad: true);
    }
}