@using Pinula.Shared.DTOs
@using Pinula.Shared.Enums
@using Microsoft.Extensions.Localization
@using Pinula.WASM.Services
@inject IStringLocalizer<App> Localizer 

@if (IsVisible)
{
    <div class="modal-overlay">
        <div class="glass-modal plan-meal-modal">

            <div class="modal-header">
                <img src="images/icons/calendar.png" style="filter: invert(1); width:30px; height:30px; margin-right:10px;" />
                <h2 style="display:inline-block"> Edit meal plan</h2>
                <button class="close-modal-btn" @onclick="Close">&times;</button>
            </div>

            <div class="modal-body">
                <div class="preselected-recipe-card modal-spacer-md">
                    <div class="recipe-info">
                        <div>
                            <small class="recipe-label-sub">@Localizer["Recipe"]</small>
                            <span>@RecipeName</span>
                        </div>
                    </div>
                </div>

                <div class="form-row-2 modal-spacer-md">
                    <div class="modal-section">
                        <label class="section-label">@Localizer["Date"]</label>
                        <input type="date" class="modal-input" @bind="EditDate" />
                    </div>
                    <div class="modal-section">
                        <label class="section-label">@Localizer["MealTime"]</label>
                        <select class="modal-input" @bind="EditMealType">
                            @foreach (var type in Enum.GetValues<MealType>())
                            {
                                <option value="@type">@Localizer[type.ToString()]</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="section-header-flex modal-spacer-sm">
                    <label class="section-label">@Localizer["Servings"]</label>
                    <div class="servings-selector">
                        <input type="number" min="1" max="20" class="input-servings" @bind="Servings" />
                        <span>@Localizer["Portions"]</span>
                    </div>
                </div>

                <div class="modal-section modal-spacer-top-lg">
                    <label class="section-label section-label-block">@Localizer["WhoIsEating"]</label>
                    <div class="eaters-selection">
                        @foreach (var member in AllGroupMembers)
                        {
                            var isSelected = SelectedUserIds.Contains(member.Id);
                            <div class="eater-avatar-wrapper @(isSelected ? "selected" : "")"
                                 @onclick="() => ToggleUser(member.Id)"
                                 title="@member.Name @member.Surname">
                                <img src="@member.AvatarUrl" class="eater-avatar" alt="@member.Name" />
                                @if (isSelected)
                                {
                                    <div class="eater-check">
                                        <i class="fa-check"></i>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                
                <div class="modal-section">
                    <div class="servings-selector">
                        <label class="section-label section-label-block">@Localizer["Ingredients"]:</label>
                        <div class="flex-spacer"></div>
                        <button class="btn-icon-add" style="margin-bottom: 12px" @onclick="() => ToggleAddIngredientPopup()">
                            + @Localizer["Add"]
                        </button>
                    </div>
                    @foreach (var ing in MealPlanIngredients)
                    {
                        <div class="ingredient-row">
                            <input type="number" class="custom-input qty" @bind="@ing.Quantity"/>
                            <span class="unit">@ing.Unit.Name</span>
                            <span class="name">@ing.Ingredient.Name</span>
                            <button type="button" class="btn-delete-mp" @onclick="() => RemoveIngredient(ing)">✕</button>
                        </div>
                    }
                </div>
            </div>
            

            <div class="modal-footer">
                <button type="button" class="btn-delete-mp" @onclick="HandleDelete">@Localizer["DeleteFromPlan"]</button>
                <div class="flex-spacer"></div>
                <button type="button" class="btn-accent" @onclick="HandleSave" disabled="@(!SelectedUserIds.Any())">@Localizer["SaveChanges"]</button>
            </div>
        </div>
    </div>

    <AddIngredientPopup IsVisible="showIngredientPopup"
                        OnIngredientAdded="HandleNewIngredient"
                        OnClose="() => showIngredientPopup = false" />
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public List<UserDisplayDto> AllGroupMembers { get; set; } = new();

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<MealPlanUpdateDto> OnSave { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }

    private MealPlanPreviewDto MealPlan { get; set; } = new();
    private Guid MealPlanId { get; set; }
    private string RecipeName { get; set; } = string.Empty;
    private DateOnly EditDate { get; set; }
    private MealType EditMealType { get; set; }
    private HashSet<Guid> SelectedUserIds { get; set; } = new();
    private List<RecipeIngredientDisplayDto> MealPlanIngredients = new();
    
    private Dictionary<RecipeIngredientDisplayDto, decimal> IngredientQuantityPerServing { get; set; } = new();
    private int _servings = 1;

    public int Servings
    {
        get => _servings;
        set
        {
            if (value <= 0 || _servings == value) return;
            
            _servings = value;
            RecalculateIngredients();
        }
    }

    private void RecalculateIngredients()
    {
        foreach (var ingredient in MealPlanIngredients)
        {
            if (IngredientQuantityPerServing.TryGetValue(ingredient, out var baseQty))
            {
                ingredient.Quantity = HelperService.FormatSmart(baseQty * _servings, ingredient.Unit?.Code);
            }
        }
    }

    public void Open(MealPlanPreviewDto mealPlan)
    {
        MealPlan = mealPlan;
        MealPlanId = mealPlan.Id;
        RecipeName = mealPlan.RecipeName;
        EditDate = mealPlan.Date;
        EditMealType = mealPlan.MealType;
        
        _servings = mealPlan.Servings > 0 ? mealPlan.Servings : 1;
        SelectedUserIds = mealPlan.UsersPreviews.Select(u => u.Id).ToHashSet();
        
        MealPlanIngredients.Clear();
        IngredientQuantityPerServing.Clear();

        var baseServings = _servings;

        foreach (var ing in mealPlan.Ingredients)
        {
            var newMP = new RecipeIngredientDisplayDto()
            {
                ConversionFactor = ing.ConversionFactor,
                Unit = new()
                {
                    Id = ing.UnitId,
                    Name = ing.UnitName,
                    Code = ing.UnitCode
                },
                Ingredient = new()
                {
                    Id = ing.IngredientId,
                    Name = ing.IngredientName,
                },
            };
            
            var perServingQty = ing.Quantity / baseServings;
            IngredientQuantityPerServing[newMP] = perServingQty;
            
            newMP.Quantity = HelperService.FormatSmart(perServingQty * _servings, newMP.Unit.Code);

            MealPlanIngredients.Add(newMP);
        }

        IsVisible = true;
        StateHasChanged();
    }

    private async Task Close()
    {
        IsVisible = false;
        await OnClose.InvokeAsync();
    }

    private void ToggleUser(Guid userId)
    {
        if (SelectedUserIds.Contains(userId))
            SelectedUserIds.Remove(userId);
        else
            SelectedUserIds.Add(userId);
        
        Servings = SelectedUserIds.Count > 0 ? SelectedUserIds.Count : 1;
    }

    private async Task HandleSave()
    {
        var updateModel = new MealPlanUpdateDto
        {
            Id = MealPlanId,
            Date = EditDate,
            MealType = EditMealType,
            Servings = Servings,
            UsersIds = SelectedUserIds.ToList(),
            Ingredients = MealPlanIngredients
        };

        await OnSave.InvokeAsync(updateModel);
        IsVisible = false;
    }

    private async Task HandleDelete()
    {
        await OnDelete.InvokeAsync(MealPlanId);
        IsVisible = false;
    }
    
    private void RemoveIngredient(RecipeIngredientDisplayDto ing)
    {
        MealPlanIngredients.Remove(ing);
        IngredientQuantityPerServing.Remove(ing);
    }
    
    bool showIngredientPopup = false;
    private void ToggleAddIngredientPopup()
    {
        showIngredientPopup = !showIngredientPopup;          
    }

    private Task HandleNewIngredient(RecipeIngredientDisplayDto ingredient)
    {
        MealPlanIngredients.Add(ingredient);
        
        var perServing = Servings > 0 ? ingredient.Quantity / Servings : ingredient.Quantity;
        IngredientQuantityPerServing[ingredient] = perServing;

        return Task.CompletedTask;
    }
}